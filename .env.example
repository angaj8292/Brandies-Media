# Brandies Media - Production & Staging Environment Configuration

# Destination email for all consultation requests, audits, and chat leads
LEAD_RECIPIENT_EMAIL=angajkumar2262002@gmail.com

# SMTP Server Settings (Nodemailer)
# If using Gmail App Password, host is smtp.gmail.com, port 465 (secure: true) or 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-app-specific-password

# Optional: Resend API Key if switching from SMTP
RESEND_API_KEY=re_123456789

# Optional: OpenAI / Anthropic / Gemini API key for live AI audit enhancements
AI_AUDIT_API_KEY=

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://brandiesmedia.com
